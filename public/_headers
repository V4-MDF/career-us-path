# Cache long-lived, imutáveis para assets com hash gerados pelo Vite/TanStack.
# HTML permanece sem cache para deploys refletirem imediatamente.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_build/*
  Cache-Control: public, max-age=31536000, immutable

# Fontes auto-hospedadas via @fontsource, empacotadas em /assets.
*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Imagens estáticas do bundle
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.webp
  Cache-Control: public, max-age=31536000, immutable
*.avif
  Cache-Control: public, max-age=31536000, immutable
*.png
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable
